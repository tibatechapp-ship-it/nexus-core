# nexus-core — environment template
#
# Copy to `.env` and fill in only what you use.  `.env` is gitignored and must
# NEVER be committed.  Every variable below is read lazily at runtime; none is
# required for the core framework to start (all guards default to OFF).

# ── Access guard (src/security/access.py) — all OFF unless set ──
# Shared secret for mutating requests.  When empty, auth is disabled.
NEXUS_AUTH_TOKEN=
# Fixed-window rate limit (requests / window-seconds).  Default 120 / 60.
NEXUS_RATE_LIMIT=120
NEXUS_RATE_WINDOW=60
# Optional JSONL audit log path (rotated, best-effort).
NEXUS_AUDIT_LOG=

# ── /api/craft + /api/build token (main.py); empty = endpoint open ──
CRAFT_AUTH_TOKEN=

# ── Server ports / home ──
NEXUS_PORT=8000
NOVAMIND_PORT=8000
NOVAMIND_HOME=

# ── BYOK provider keys (connectors/) — set only the ones you use ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
OLLAMA_API_KEY=

# ── Local LLM (Ollama) ──
OLLAMA_HOST=http://localhost:11434
LOCAL_LLM_HOST=
LOCAL_MODEL_FAST=
LOCAL_MODEL_SMART=

# ── Storage / state (unset = built-in defaults under the repo) ──
NEXUS_DB=
NEXUS_INTERACTIONS_DB=
NEXUS_TOOLS_CONFIG=tools_config.json
NEXUS_LOCK_DIR=
NEXUS_HYPER_LOG=
ZYVO_LESSON_DB=
ZYVO_MEMORY_DB=

# ── Training / field loop (src/novamind/training) ──
NEXUS_TRAINING_DB=
NEXUS_TRAINING_LESSONS_DB=
NEXUS_TRAINING_FIELD=
