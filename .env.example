# nexus-core — environment template
#
# Copy to `.env` and fill in only what you use.  `.env` is gitignored and must
# NEVER be committed.  Every variable below is read lazily at runtime; none is
# required for the core framework to start (all guards default to OFF).

# ── Access guard (src/security/access.py) — all OFF unless set ──
# Shared secret for mutating requests.  When empty, auth is disabled.
NEXUS_AUTH_TOKEN=
# Fixed-window rate limit (requests / window-seconds).  Default 120 / 60.
NEXUS_RATE_LIMIT=120
NEXUS_RATE_WINDOW=60
# Optional JSONL audit log path (rotated, best-effort).
NEXUS_AUDIT_LOG=

# ── /api/craft + /api/build token (main.py); empty = endpoint open ──
CRAFT_AUTH_TOKEN=

# ── Server ports / home ──
NEXUS_PORT=8000
NOVAMIND_PORT=8000
NOVAMIND_HOME=

# ── BYOK provider keys (connectors/) — set only the ones you use ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
OLLAMA_API_KEY=

# ── Local LLM (Ollama) ──
OLLAMA_HOST=http://localhost:11434
LOCAL_LLM_HOST=
LOCAL_MODEL_FAST=
LOCAL_MODEL_SMART=

# ── Storage / state (unset = built-in defaults under the repo) ──
NEXUS_DB=
NEXUS_INTERACTIONS_DB=
NEXUS_TOOLS_CONFIG=tools_config.json
NEXUS_LOCK_DIR=
NEXUS_HYPER_LOG=
ZYVO_LESSON_DB=
ZYVO_MEMORY_DB=

# ── Training / field loop (src/novamind/training) ──
NEXUS_TRAINING_DB=
NEXUS_TRAINING_LESSONS_DB=
# Truthy = enable the field loop (lessons + genome evolution); 0/off/no = disable.
NEXUS_TRAINING_FIELD=

# ── Genome + maintenance (src/novamind/genome_store.py, src/maintenance) ──
# Persisted genome JSON (agents/observations/tasks).  Unset = <repo>/data/genome.json.
NEXUS_GENOME_PATH=
# Append-only maintenance task ledger (.jsonl).  Unset = <repo>/data/task_log.jsonl.
NEXUS_TASK_LOG=
# Minimum sample size before maintenance metrics report ``sample_sufficient``.
NEXUS_MIN_SAMPLE=30

# ── Orchestrator (src/orchestrator/) ──
# Verb-alias routing (expand task verbs to domain keywords).  0/off = rollback.
NEXUS_ALIASES=1
# Task decomposition into sub-tasks.  Default ON; 0/off disables.
NEXUS_DECOMPOSE=1
# Verbose jury output (per-member verdicts).  Default 0 hides them (v1.26.1).
NEXUS_UI_VERBOSE=0
# Council trace log (.jsonl, full verdicts).  Unset = <repo>/data/council_trace.jsonl.
NEXUS_COUNCIL_TRACE=

# ── Security gatekeeper log (src/novamind/core/security_gatekeeper.py) ──
# Log path + size-rotation.  Defaults: memory/security_log.jsonl, 10 MiB, 5 backups.
# A value <= 0 for BACKUPS means "unlink instead of rotate".
NEXUS_SECURITY_LOG=
NEXUS_SECURITY_LOG_MAX_BYTES=
NEXUS_SECURITY_LOG_BACKUPS=

# ── Maintenance task generator (scripts/generate_tasks.py) ──
# Gateway base URL and the hard cap on generated tasks (never HIGH).
NEXUS_BASE=http://127.0.0.1:8000
NEXUS_MAX_TASKS=10
# Log file for the generator run.  Unset = <repo>/data/generator.log.
NEXUS_GENERATOR_LOG=

# ── Groq provider endpoint override (src/novamind/core/providers/groq_provider.py) ──
# Override the API base only if you use a proxy; unset = api.groq.com.
GROQ_ENDPOINT=

# ── Ad-hoc RAG agent runner (scripts/_run_agent_with_rag.py) ──
NEXUS_AGENT=
NEXUS_PROMPT=
NEXUS_RAG=1

# ── Cleanup script (scripts/cleanup.py) ──
# Log path for cleanup runs.  Unset = <repo>/data/cleanup.log.
NEXUS_CLEANUP_LOG=

# ── Retention script (scripts/retention.py) ──
# Prune the episodic memory log.  Dry-run by default; --apply deletes.
# Defaults filled when the matching CLI flag is omitted (a non-positive value
# means "unset").  Times out: unset = no limit for that axis.
NEXUS_RETENTION_DAYS=
NEXUS_RETENTION_EPISODES=
# Log path for retention runs.  Unset = <repo>/data/retention.log.
NEXUS_RETENTION_LOG=

# ── Standalone assistants (zyvo-telegram.py / zyvo-voice.py) ──
ZYVO_TELEGRAM_PORT=
ZYVO_VOICE_PORT=
ZYVO_VOICE_MODEL=
ZYVO_VOICE_TTS_LANG=

# ── Network bindings (loopback by default — override only with intent) ──
# All standalone servers bind to 127.0.0.1 by default. Changing these to
# 0.0.0.0 exposes the service to the network; you MUST then set
# NEXUS_AUTH_TOKEN (see src/security/access.py) or use a reverse proxy with TLS.
#
# unified_agent.py: workspace API (unauthenticated by design)
NEXUS_BIND=127.0.0.1
# src/novamind/core/a2a/server.py: agent-to-agent endpoint
NEXUS_A2A_BIND=127.0.0.1
# src/novamind/dashboard/app.py: dashboard UI
NEXUS_DASH_BIND=127.0.0.1
