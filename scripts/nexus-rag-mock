#!/data/data/com.termux/files/usr/bin/bash
# nexus-rag-mock — RAG + Agent + Mock LLM (no keys)
export NOVAMIND_HOME="$HOME/nexus-core"
export PYTHONPATH="src:$PYTHONPATH"
export WORKSPACE_DIR="$HOME/nexus-core/workspace"
export NEXUS_AGENT="$1"
export NEXUS_PROMPT="${@:2}"
export NEXUS_RAG="1"
cd "$HOME/nexus-core"

python3 << 'PYEOF'
import os, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)
sys.path.insert(0, os.path.join(ROOT, 'src'))

# ═══ Mock LLM ═══
from novamind.core.llm_router import LLMRouter

def mock_generate(self, prompt="", system="", **kwargs):
    return {"ok": True, "text": f"# Mock code for: {str(prompt)[:100]}\n\ndef solution():\n    return 42\n",
            "provider": "mock", "model": "mock", "elapsed": 0.01}

def mock_gft(self, task_type="", prompt="", system="", **kwargs):
    return mock_generate(self, prompt, system, **kwargs)

LLMRouter.generate = mock_generate
LLMRouter.generate_for_task = mock_gft
LLMRouter._load_from_env = lambda self: setattr(self, 'providers', [])
LLMRouter._cooldown_provider = lambda self, n, seconds=300: None
LLMRouter._is_cooled_down = lambda self, n: True

# ═══ RAG ═══
from src.memory.agent_rag_bridge import get_bridge
bridge = get_bridge()

agent_name = os.environ.get("NEXUS_AGENT", "")
prompt = os.environ.get("NEXUS_PROMPT", "اختبار")

# إثراء بالسياق
enriched = bridge.enrich_prompt(prompt, k=3)
if enriched != prompt:
    print("🧠 تم إثراء الطلب بسياق من الذاكرة")

# ═══ تشغيل الوكيل ═══
from nova.registry import REGISTRY
agent = REGISTRY.load_agent(agent_name)
print(f"✅ محمّل: {type(agent).__name__}")

methods = ["build", "run", "execute", "analyze", "fix", "review", "generate"]
method = next((m for m in methods if hasattr(agent, m)), None)
if not method:
    print("❌ لا توجد طريقة")
    sys.exit(1)

print(f"🔧 الطريقة: {method}")
result = getattr(agent, method)(enriched)
print(str(result)[:800])

# حفظ النتيجة
if isinstance(result, dict) and result.get("ok"):
    text = result.get("code") or result.get("text") or str(result)[:200]
    doc_id = bridge.remember(f"Agent {agent_name}: {text[:200]}")
    print(f"💾 حُفظت في الذاكرة: {doc_id}")
PYEOF
