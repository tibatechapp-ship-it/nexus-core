#!/data/data/com.termux/files/usr/bin/bash
export NOVAMIND_HOME="$HOME/nexus-core"
export PYTHONPATH="src:.:$PYTHONPATH"
export NEXUS_QUESTION="$1"
export NEXUS_MODE="${2:-real}"
cd "$HOME/nexus-core"

python3 << 'PYEOF'
import os, sys
sys.path.insert(0, '.')
sys.path.insert(0, 'src')

mode = os.environ.get("NEXUS_MODE", "mock")

from novamind.core.llm_router import get_router

if mode != "real":
    print("❌ وضع mock غير متاح في nexus-council. استخدم أداة محاكاة صريحة.")
    sys.exit(2)

router = get_router()
real_providers = [
    provider for provider in router.providers
    if getattr(provider, "name", "") != "mock"
    and getattr(provider, "enabled", True)
]
if not real_providers:
    print("❌ لا يوجد مزود LLM حقيقي مهيأ.")
    print("أضف مفاتيح مزود صالح إلى .env أو NOVAMIND_HOME/.env.")
    sys.exit(2)

from src.council.rag_bridge import get_council_bridge

question = os.environ.get("NEXUS_QUESTION", "")
print("=" * 60)
print("🏛️  مجلس الوكلاء — Nexus Council")
print("=" * 60)
print(f"❓ {question}")
print("🟢 الوضع: REAL PROVIDER MODE")
print("=" * 60 + "\n")

bridge = get_council_bridge()
result = bridge.deliberate_with_memory(question)
if not getattr(result, "execution_ok", False):
    print("❌ فشل تنفيذ المجلس؛ لا يوجد قرار صالح.")
    for error in getattr(result, "errors", []):
        print("   " + str(error)[:200])
    sys.exit(3)

print("\n" + "=" * 60)
print(f"📊 القرار: {result.verdict.upper()}")
print(f"   النقاط: {result.score:.2f}")
print(f"   الجولات: {result.rounds}")
print(f"   الوقت: {result.elapsed:.2f}ث")
print(f"   توافق: {'✅' if result.consensus else '❌'}")
print("=" * 60)

print(f"\n💬 المداخلات ({len(result.transcript)}):")
for entry in result.transcript:
    print(f"\n─── {entry['phase']} | {entry['member']} ───")
    print(f"{entry['response'][:250]}")

if result.security_events:
    print(f"\n🛡️ أحداث أمنية: {len(result.security_events)}")
    for e in result.security_events[:5]:
        print(f"   • {e}")

if result.verdict != "approve":
    sys.exit(4)
PYEOF
