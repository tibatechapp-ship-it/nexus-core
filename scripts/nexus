#!/data/data/com.termux/files/usr/bin/bash
# nexus — Unified CLI (79 agents + RAG)
export NOVAMIND_HOME="$HOME/nexus-core"
export PYTHONPATH="src:$PYTHONPATH"
export WORKSPACE_DIR="$HOME/nexus-core/workspace"
cd "$HOME/nexus-core"

CMD="$1"
shift

case "$CMD" in
  list)
    python3 -c "
from nova.registry import agents_by_category
for cat in ['code','security','quality','infra','data','ui','research','meta']:
    agents = agents_by_category(cat)
    print(f'\n📁 {cat.upper()} ({len(agents)}):')
    for a in agents: print(f'   • {a}')
"
    ;;
  stats)
    python3 -c "
from nova.registry import REGISTRY, agents_by_category
print(f'📊 {len(REGISTRY)} agents | 8 categories')
for cat in ['code','security','quality','infra','data','ui','research','meta']:
    print(f'   • {cat:10} {len(agents_by_category(cat)):2} agents')
"
    ;;
  core)
    python3 -c "
from nova.registry import REGISTRY
for n in REGISTRY.list_core():
    spec = REGISTRY.get(n)
    print(f'  {n:25} | {spec.category.value:10}')
"
    ;;
  doctor)
    ./scripts/nexus-doctor
    ;;
  rag)
    ./scripts/nexus-rag "${@}"
    ;;
  offline)
    ./scripts/nexus-offline "${@}"
    ;;
  run)
    ./scripts/nexus-offline "${@}"
    ;;
  *)
    echo "╔══════════════════════════════════════════════════╗"
    echo "║  nexus — Unified CLI (79 agents + RAG)          ║"
    echo "╚══════════════════════════════════════════════════╝"
    echo ""
    echo "الأوامر:"
    echo "  nexus list                  عرض كل الوكلاء"
    echo "  nexus stats                 إحصائيات"
    echo "  nexus core                  الوكلاء الأساسيون"
    echo "  nexus doctor                فحص شامل"
    echo "  nexus rag add TEXT          إضافة للذاكرة"
    echo "  nexus rag query Q           بحث دلالي"
    echo "  nexus rag ask Q             سؤال + سياق"
    echo "  nexus run NAME PROMPT       تشغيل وكيل"
    echo ""
    echo "أمثلة:"
    echo "  nexus stats"
    echo "  nexus rag ask 'ما هي Python؟'"
    echo "  nexus run coder 'اكتب دالة'"
    ;;
esac
