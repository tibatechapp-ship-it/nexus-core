#!/data/data/com.termux/files/usr/bin/bash
# nexus-run — Smart Router + Supervisor
export NOVAMIND_HOME="$HOME/nexus-core"
export PYTHONPATH="src:.:$PYTHONPATH"
export WORKSPACE_DIR="$HOME/nexus-core/workspace"
export NEXUS_PROMPT="$*"
export NEXUS_STRATEGY="${NEXUS_STRATEGY:-auto}"
cd "$HOME/nexus-core"

python3 << 'PYEOF'
import os, sys
sys.path.insert(0, '.')
sys.path.insert(0, 'src')

# Mock LLM
from novamind.core.llm_router import LLMRouter
def mock_gen(self, prompt="", system="", **kw):
    s = str(system); p = str(prompt)
    if "أنت الناقد" in s:
        t = "مقبول مع التحفظ."
    elif "أنت المحلل المتشكك" in s:
        t = "خطر: نقص السياق."
    elif "أنت المحلل المدافع" in s:
        t = "آمن: الطلب مقبول."
    else:
        t = f"[Mock] {p[:150]}"
    return {"ok": True, "text": t, "provider": "mock", "elapsed": 0.01}
LLMRouter.generate = mock_gen
LLMRouter.generate_for_task = lambda self, *a, **kw: mock_gen(self, *a, **kw)
LLMRouter._load_from_env = lambda self: setattr(self, 'providers', [])
LLMRouter._cooldown_provider = lambda self, n, seconds=300: None
LLMRouter._is_cooled_down = lambda self, n: True

from src.orchestrator.supervisor import Supervisor

prompt = os.environ.get("NEXUS_PROMPT", "").strip()
strategy = os.environ.get("NEXUS_STRATEGY", "auto")

if not prompt:
    print("الاستخدام: nexus-run 'طلبك'")
    print("")
    print("أمثلة:")
    print("  nexus-run 'اكتب دالة Python'")
    print("  nexus-run 'أصلح خطأ في ملف app.py'")
    print("  nexus-run 'افحص الكود أمنياً'")
    print("  NEXUS_STRATEGY=parallel nexus-run 'تحليل شامل'")
    sys.exit(1)

print("=" * 60)
print("🧠 Nexus Smart Router")
print("=" * 60)
print(f"📝 الطلب: {prompt[:120]}")
print()

sup = Supervisor(use_rag=True, verbose=True)
result = sup.execute(prompt, force_strategy=None if strategy == "auto" else strategy)

print()
print("=" * 60)
print("📊 النتيجة النهائية")
print("=" * 60)
print(f"   ✅ النجاح:    {result['ok']}")
print(f"   ⏱️  الوقت:     {result['elapsed']}ث")
print(f"   👥 الوكلاء:   {len(result['results'])}")
print()
print(f"🎯 القرار المُتخذ:")
d = result['decision']
print(f"   • الاستراتيجية: {d['strategy']}")
print(f"   • الفئة:        {d['category']}")
print(f"   • التعقيد:      {d['complexity']}")
print(f"   • الخطورة:      {d['risk']}")
print()
print("📋 تفاصيل الوكلاء:")
for r in result["results"]:
    s = "✅" if r.get("ok") else "❌"
    agent = r.get("agent", "?")
    elapsed = r.get("elapsed", 0)
    print(f"   {s} {agent:20} {elapsed}ث")
    if r.get("error"):
        print(f"      └─ خطأ: {r['error'][:100]}")
    if r.get("verdict"):
        print(f"      └─ القرار: {r['verdict']} ({r.get('score', 0):.2f})")
PYEOF
