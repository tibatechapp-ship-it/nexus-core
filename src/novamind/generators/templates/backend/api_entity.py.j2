"""{{ ir.name }} — {{ entity.name }} API endpoints."""
from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from ..db import get_db
from ..models import {{ entity.name }}

router = APIRouter(prefix="/{{ entity.table_name }}", tags=["{{ entity.name }}"])


@router.get("/")
def list_{{ entity.table_name }}(db: Session = Depends(get_db)):
    items = db.query({{ entity.name }}).all()
    return [item.to_dict() for item in items]


@router.get("/{item_id}")
def get_{{ entity.snake_name }}(item_id: int, db: Session = Depends(get_db)):
    item = db.query({{ entity.name }}).filter({{ entity.name }}.{{ entity.primary_field.name }} == item_id).first()
    if not item:
        raise HTTPException(status_code=404, detail="{{ entity.name }} not found")
    return item.to_dict()


@router.post("/")
def create_{{ entity.snake_name }}(payload: dict, db: Session = Depends(get_db)):
    item = {{ entity.name }}(**payload)
    db.add(item)
    db.commit()
    db.refresh(item)
    return item.to_dict()


@router.delete("/{item_id}")
def delete_{{ entity.snake_name }}(item_id: int, db: Session = Depends(get_db)):
    item = db.query({{ entity.name }}).filter({{ entity.name }}.{{ entity.primary_field.name }} == item_id).first()
    if not item:
        raise HTTPException(status_code=404, detail="{{ entity.name }} not found")
    db.delete(item)
    db.commit()
    return {"deleted": item_id}
