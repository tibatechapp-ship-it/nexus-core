"""
Fixer Agent v2 — Multi-strategy fix with verification.
Strategies (safest → most aggressive):
1. Deterministic (pattern → direct fix)
2. Template (predefined patterns)
3. LLM (with verification)
"""
import logging
import re
import time
from typing import Dict, List, Optional

logger = logging.getLogger("agents.fixer")

# Try code_safety
try:
    from nova.core.safety.code_safety import (
        protect_code, unprotect_code, integrity_check, detect_code_errors,
    )
    SAFETY_AVAILABLE = True
except ImportError:
    SAFETY_AVAILABLE = False
    logger.warning("code_safety not available")


class FixerAgent:
    """Multi-strategy code fixer with verification."""

    def __init__(self):
        self.name = "fixer"
        self.stats = {
            "deterministic": 0,
            "template": 0,
            "llm": 0,
            "failed": 0,
        }

    def fix(self, code: str, error: str = "", issues: Optional[List] = None,
            previous_attempts: Optional[List] = None) -> Dict:
        """
        Fix code. Returns {ok, fixed, strategy, confidence, change}.
        """
        issues = issues or []
        previous_attempts = previous_attempts or []

        # 1. Deterministic
        result = self._try_deterministic(code, issues)
        if result.get("ok"):
            self.stats["deterministic"] += 1
            return result

        # 2. Template
        result = self._try_template(code, issues)
        if result.get("ok"):
            self.stats["template"] += 1
            return result

        # 3. LLM (with verification)
        result = self._try_llm(code, error, issues, previous_attempts)
        if result.get("ok"):
            self.stats["llm"] += 1
            return result

        self.stats["failed"] += 1
        return {"ok": False, "error": "all strategies failed"}

    # ═══════════════════════════════════════════════════════
    # Strategy 1: Deterministic
    # ═══════════════════════════════════════════════════════
    def _try_deterministic(self, code: str, issues: List) -> Dict:
        """Apply safe pattern-based fixes."""
        new_code = code
        applied = []

        # Fix 1: == None → is None
        if "== None" in new_code:
            new_code = new_code.replace("== None", "is None")
            applied.append("== None → is None")
        if "!= None" in new_code:
            new_code = new_code.replace("!= None", "is not None")
            applied.append("!= None → is not None")

        # Fix 2: bare except
        if "except:" in new_code:
            new_code = new_code.replace("except:", "except Exception as e:")
            applied.append("except: → except Exception as e:")

        # Fix 3: tabs → spaces
        if "\t" in new_code:
            new_code = new_code.replace("\t", "    ")
            applied.append("tabs → spaces")

        if not applied or new_code == code:
            return {"ok": False, "reason": "no deterministic fix"}

        # Verify
        verify = self._verify(code, new_code)
        if not verify.get("ok"):
            return {"ok": False, "reason": f"verification failed: {verify.get('error')}"}

        return {
            "ok": True,
            "fixed": new_code,
            "strategy": "deterministic",
            "confidence": 0.99,
            "change": " | ".join(applied),
        }

    # ═══════════════════════════════════════════════════════
    # Strategy 2: Template
    # ═══════════════════════════════════════════════════════
    TEMPLATES = {
        "print_parens": {
            "from": r"print\s+(?!\()(.+)",
            "to": r"print(\1)",
            "desc": "print with parens",
        },
        "var_to_let": {
            "from": r"\bvar\s+",
            "to": "let ",
            "desc": "var → let",
        },
        "double_eq": {
            "from": r"([^=!<>])==([^=])",
            "to": r"\1===\2",
            "desc": "== → ===",
        },
    }

    def _try_template(self, code: str, issues: List) -> Dict:
        """Apply template fixes for known patterns."""
        new_code = code
        applied = []

        for name, tpl in self.TEMPLATES.items():
            try:
                if re.search(tpl["from"], new_code):
                    new_code = re.sub(tpl["from"], tpl["to"], new_code)
                    applied.append(tpl["desc"])
            except re.error:
                continue

        if not applied or new_code == code:
            return {"ok": False, "reason": "no template match"}

        verify = self._verify(code, new_code)
        if not verify.get("ok"):
            return {"ok": False, "reason": "verification failed"}

        return {
            "ok": True,
            "fixed": new_code,
            "strategy": "template",
            "confidence": 0.9,
            "change": " | ".join(applied),
        }

    # ═══════════════════════════════════════════════════════
    # Strategy 3: LLM with verification
    # ═══════════════════════════════════════════════════════
    def _try_llm(self, code: str, error: str, issues: List,
                 previous: List) -> Dict:
        """Use LLM with protection + verification."""
        if not SAFETY_AVAILABLE:
            return {"ok": False, "reason": "code_safety not available"}

        try:
            from nova.core.llm_router import get_router
            router = get_router()
        except ImportError:
            return {"ok": False, "reason": "llm_router not available"}

        # Protect strings
        protected, originals = protect_code(code)

        # Build prompt
        issues_text = "\n".join([
            f"- L{i.get('line', '?')}: {i.get('message', '')[:100]}"
            for i in issues[:10]
        ])

        prev_text = ""
        if previous:
            prev_text = "\n\nمحاولات سابقة فشلت:\n"
            for p in previous[-2:]:
                prev_text += f"- {str(p)[:200]}\n"

        prompt = f"""أنت مهندس إصلاح أخطاء خبير.

الكود الأصلي:

الأخطاء:
{issues_text or error[:500]}
{prev_text}

مهمتك:
1. أصلح الأخطاء بأقل تغيير ممكن
2. لا تضف features جديدة
3. حافظ على التنسيق والمسافات
4. لا تلمس النصوص العربية
5. أعد الكود كاملاً فقط (بدون شرح، بدون markdown)

الكود المُصلَح:"""

        try:
            result = router.generate_for_task(
                task_type="smart",
                prompt=prompt,
                system="أعد الكود كاملاً فقط.",
                max_tokens=3000,
            )
        except Exception as e:
            return {"ok": False, "reason": f"LLM call failed: {str(e)[:100]}"}

        if not result.get("ok"):
            return {"ok": False, "reason": "LLM returned error"}

        fixed = result.get("text", "").strip()

        # Strip markdown fences
        if fixed.startswith("```"):
            lines = fixed.split("\n")
            if lines[0].startswith("```"):
                lines = lines[1:]
            if lines and lines[-1].strip() == "```":
                lines = lines[:-1]
            fixed = "\n".join(lines)

        # Unprotect
        fixed = unprotect_code(fixed, originals)

        # Verify
        verify = self._verify(code, fixed)
        if not verify.get("ok"):
            return {"ok": False, "reason": f"verification: {verify.get('error')}"}

        return {
            "ok": True,
            "fixed": fixed,
            "strategy": "llm",
            "confidence": 0.75,
            "provider": result.get("provider", ""),
            "change": "LLM-based",
        }

    # ═══════════════════════════════════════════════════════
    # Verification
    # ═══════════════════════════════════════════════════════
    def _verify(self, original: str, fixed: str) -> Dict:
        """Verify fix didn't break anything."""
        if not fixed or not fixed.strip():
            return {"ok": False, "error": "empty result"}

        # Integrity check
        if SAFETY_AVAILABLE:
            try:
                result = integrity_check(original, fixed, is_code=True)
                if not result.get("ok"):
                    return {"ok": False, "error": str(result.get("issues", [])[:1])}
            except Exception:
                pass

        # For Python: check syntax
        import ast
        try:
            ast.parse(original)
            orig_valid = True
        except SyntaxError:
            orig_valid = False

        if orig_valid:
            try:
                ast.parse(fixed)
            except SyntaxError as e:
                return {"ok": False, "error": f"syntax broken: {e.msg}"}

        return {"ok": True}

    def stats_report(self) -> Dict:
        total = sum(self.stats.values())
        return {
            **self.stats,
            "total": total,
            "success_rate": (total - self.stats["failed"]) / total if total else 0,
        }


# Export
fixer_agent = FixerAgent()
__all__ = ["FixerAgent", "fixer_agent"]
