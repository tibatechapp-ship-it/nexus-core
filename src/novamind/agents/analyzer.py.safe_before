"""
AnalyzerAgent - Static analysis of Python code
- Uses LLM Router (Gemini/Qwen/DeepSeek fallback)
- Returns structured JSON verdict
- Incorporates learned lessons from memory
- No direct Gemini dependency
"""
from pathlib import Path
import json
import re
import logging
from typing import Dict, List
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from nova.core.llm_router import get_router
from nova.core.cost_router import get_cost_router
from memory import memory

logger = logging.getLogger("agents.analyzer")


SYSTEM_PROMPT = """You are an expert Python code analyzer.
Analyze the given code carefully and report REAL issues only - never invent problems.

Return strict JSON in this exact format:
{
  "verdict": "ok" | "issues" | "broken",
  "issues": [
    {"type": "syntax|logical|security|runtime", "line": <number>, "description": "<short>"}
  ],
  "summary": "<one line>"
}

Rules:
- verdict=ok: code is clean
- verdict=issues: warnings but runs
- verdict=broken: definite error that will fail
- Include line numbers where possible
- Be concise. No prose outside JSON.
"""


def _extract_json(text: str) -> Dict:
    """Extracts the first JSON object from a text response."""
    if not text:
        return {}

    # Try direct parse
    try:
        return json.loads(text.strip())
    except Exception:
        pass

    # Try finding JSON object in the text
    match = re.search(r'\{.*\}', text, re.DOTALL)
    if match:
        try:
            return json.loads(match.group(0))
        except Exception:
            pass

    return {}


class AnalyzerAgent:
    def __init__(self):
        self.name = "analyzer"
        self.router = get_router()

    def analyze(self, code: str, filename: str = "code.py") -> Dict:
        """
        Analyzes Python code and returns a structured verdict.
        """
        if not code or not code.strip():
            return {
                "verdict": "broken",
                "issues": [{"type": "syntax", "line": 0, "description": "empty code"}],
                "summary": "no code provided",
            }

        # Include relevant learned lessons
        memory_ctx = ""
        try:
            recall = memory.recall("python error")
            if recall.get("semantic"):
                memory_ctx = "Previously learned lessons:\n" + recall["semantic"] + "\n"
        except Exception as e:
            logger.warning("memory recall failed: " + str(e))

        prompt = memory_ctx + "File: " + filename + "\n\n```python\n" + code + "\n```\n\nReturn JSON only."

        logger.info("analyzing " + filename + " via router")

        cost_router = get_cost_router()
        result = cost_router.generate_for_task(
            task_type="analysis",
            prompt=prompt,
            system=SYSTEM_PROMPT,
            temperature=0.1,
            max_tokens=800,
        )

        if not result.get("ok"):
            logger.error("router failed: " + result.get("error", ""))
            return {
                "verdict": "issues",
                "issues": [],
                "summary": "analyzer offline: " + result.get("error", "")[:80],
                "provider": result.get("provider", ""),
            }

        parsed = _extract_json(result["text"])

        # Fallback if parsing failed
        if not parsed or "verdict" not in parsed:
            parsed = {
                "verdict": "issues",
                "issues": [],
                "summary": "could not parse analyzer output",
            }

        parsed["provider"] = result.get("provider", "")
        parsed["model"] = result.get("model", "")
        parsed["elapsed"] = result.get("elapsed", 0.0)

        logger.info(
            "verdict=" + parsed.get("verdict", "?") +
            " issues=" + str(len(parsed.get("issues", []))) +
            " provider=" + parsed.get("provider", "?")
        )
        return parsed

    def format(self, analysis: Dict) -> str:
        """Human-readable formatting for logs."""
        v = analysis.get("verdict", "?")
        issues = analysis.get("issues", [])
        summary = analysis.get("summary", "")
        lines = ["verdict: " + v]
        for i in issues:
            lines.append("  - line " + str(i.get("line", "?")) + ": " + i.get("description", ""))
        if summary:
            lines.append("summary: " + summary)
        return "\n".join(lines)


analyzer = AnalyzerAgent()
